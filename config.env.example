# ---------------------------------------------------------------
#  Machine-specific settings for the touch dashboard.
#
#  Copy to `config.env` and edit. config.env is gitignored, so the
#  repo stays portable and nothing machine-specific gets committed.
#
#      cp config.env.example config.env
#      ./install.sh --detect     # prints this machine's real values
#
#  Every value has a sensible fallback, so a missing config.env
#  degrades rather than breaks.
# ---------------------------------------------------------------

# --- Display ---------------------------------------------------
# Output the dashboard runs on (hyprctl monitors).
DASH_MONITOR="HDMI-A-3"

# Touchscreen device name -- run `./install.sh --detect` to find yours
# (e.g. "istaric-istaric"). Empty skips the touch->output mapping, which
# is correct for a non-touch panel; a WRONG name silently breaks touch.
DASH_TOUCH_DEVICE=""

# Hyprland workspace for the kiosk. Named avoids colliding with numeric
# workspaces; note waybar renders named workspaces as a negative id.
DASH_WORKSPACE="panel"

# --- Waybar ----------------------------------------------------
# Outputs the bar SHOULD appear on - i.e. every monitor except the panel.
DASH_BAR_OUTPUTS='["DP-1", "DP-2"]'
# Theme to clone from, and the name of your private copy.
DASH_THEME_SRC="ml4w-minimal"
DASH_THEME_DST="adam-minimal"

# --- System stats ----------------------------------------------
# Network interface for throughput (ip -br link).
DASH_IFACE="eno2"
# Filesystems to show, comma separated.
DASH_DISKS="/,/mnt/storage,/mnt/share"

# --- Weather ---------------------------------------------------
# 0 disables the outbound wttr.in request entirely.
DASH_WEATHER="1"
# Blank = geolocate by public IP. Or set e.g. "Sacramento".
DASH_WEATHER_LOC=""
# F or C
DASH_UNITS="F"

# --- Server ----------------------------------------------------
DASH_PORT="8770"
